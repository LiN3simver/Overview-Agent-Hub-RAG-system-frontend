# 複製成 .env 後填入實際值（.env 在 .gitignore 裡，不會進版控）。
# 所有 agent 經由 agentkit.gateway 讀這一份，換模型或換 key 只改這裡。

# Anthropic Messages API 相容的 LLM gateway
LLM_BASE_URL=http://127.0.0.1:4000
# 以 Authorization: Bearer 送出
LLM_API_KEY=your-api-key
# 必須與 gateway /v1/models 回傳的 id 完全一致
LLM_MODEL=your-model-id
# 主模型回 404/400（unknown model）時才改用這顆；留空 = 不退
LLM_MODEL_FALLBACK=

LLM_MAX_TOKENS=4000
LLM_TIMEOUT=240
# 委派迴圈最多幾輪工具呼叫
A2A_MAX_STEPS=8
